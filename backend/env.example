# Google Gemini / Llama Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLAMA_MODEL=gemini-2.5-flash
LLAMA_TEMPERATURE=0.1

# Performance & Streaming Configuration
ENABLE_STREAMING=true
STREAM_CHUNK_SIZE=100
REQUEST_TIMEOUT=300
CONNECTION_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=10

# API Configuration
DEBUG=False

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Analysis Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS_PER_REQUEST=4000

# PageIndex AI Configuration
PAGEINDEX_API_KEY=your_pageindex_api_key_here

